{
  "name": "jarrettwilliams-blog-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editorial static site for jarrettwilliams.com, built with Astro.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "new-post": "node scripts/new-post.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "astro": "^7.4.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5"
  }
}
