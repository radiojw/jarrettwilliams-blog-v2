---
import "../styles/global.css"
import BottomNav from "../components/BottomNav.astro"
import CookieBanner from "../components/CookieBanner.astro"
import { site } from "../lib/site"

interface Props {
  title: string
  description: string
  ogType?: "website" | "article"
  image?: string
  publishedTime?: string
  robots?: string
  jsonLd?: unknown
  showMasthead?: boolean
  canonicalPath?: string
}

const {
  title,
  description,
  ogType = "website",
  image = site.socialImagePath,
  publishedTime,
  robots = "index,follow,max-image-preview:large",
  jsonLd,
  showMasthead = true,
  canonicalPath,
} = Astro.props

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href
const imageUrl = new URL(image, site.url).href
const jsonLdHtml = jsonLd
  ? `<script type="application/ld+json">${JSON.stringify(jsonLd).replace(/</g, "\\u003c")}</script>`
  : ""
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && <meta property="article:author" content={site.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#f4f1e8" data-theme-color />
    <script is:inline src="/assets/theme.js"></script>
    <link rel="preload" href="/assets/fonts/source-serif-4-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title={`${site.title} feed`} href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title={`${site.title} JSON feed`} href="/feed.json" />
    {jsonLdHtml && <Fragment set:html={jsonLdHtml} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={["site-shell", showMasthead && "site-shell-page"]}>
      {
        showMasthead && (
          <header class="masthead">
            <a class="wordmark" href="/">
              Jarrett Williams
            </a>
          </header>
        )
      }
      <main id="main">
        <slot />
      </main>
      <footer class="colophon">
        <p>Copyright 2026 jarrettwilliams.com</p>
        <p>
          <a href="/cookies/">Cookies</a>
          {" · "}
          <a href="/privacy/">Privacy</a>
          {" · "}
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>
      </footer>
    </div>
    <BottomNav />
    <CookieBanner />
    <script is:inline src="/assets/consent.js" defer></script>
    <script is:inline src="/assets/search.js" defer></script>
    <script is:inline src="/umami/script.js" data-website-id={site.umamiId} defer></script>
    <script is:inline type="speculationrules" src="/assets/speculationrules.json"></script>
  </body>
</html>
