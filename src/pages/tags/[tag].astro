---
import Base from "../../layouts/Base.astro"
import NoteCard from "../../components/NoteCard.astro"
import { allTags, getPosts } from "../../lib/posts"
import { pageJsonLd } from "../../lib/seo"
import { site } from "../../lib/site"

export async function getStaticPaths() {
  const tags = allTags(await getPosts())
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }))
}

const { tag } = Astro.props
const description = `${tag.count} ${tag.count === 1 ? "note" : "notes"} tagged ${tag.label}.`
---

<Base
  title={`${tag.label} — ${site.title}`}
  description={description}
  jsonLd={pageJsonLd(`${tag.label} — ${site.title}`, `/tags/${tag.slug}/`, description)}
>
  <section class="page">
    <p class="kicker page-kicker">Topic</p>
    <h1>{tag.label}</h1>
    <p class="page-lede">{description}</p>
    <div class="note-list">
      {tag.posts.map((post) => <NoteCard post={post} />)}
    </div>
    <a class="back-link" href="/blog/">All notes</a>
  </section>
</Base>
